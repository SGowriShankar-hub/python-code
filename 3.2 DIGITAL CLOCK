import time
import sys
h=int(input("enter the hour: "))
m=int(input("enter the minutes: "))
s=int(input("enter the seconds: "))
while True:
    sys.stdout.write("\r{:02d}:{:02d}:{:02d}".format(h,m,s))
    sys.stdout.flush()
    time.sleep(1)
    s=s+1
    if s==60:
        s=0
        m=m+1
    if m==60:
        m=0
        h=h+1
        s=0
    if h==13:
        h=0
        m=0
        s=0
