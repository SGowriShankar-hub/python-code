m=[[10,11,12,13,14,15],
   [20,21,22,23,24,25],
   [30,31,32,33,34,35],
   [40,41,42,43,44,45],
   [50,51,52,53,54,55]]
top=0
bottom=len(m)-1
left=0
right=len(m[0])-1

while(top<=bottom and left<=right):
    for i in range(left,right+1):
        print(m[top][i],end=" ")
    top=top+1
    
    for i in range(top,bottom+1):
        print(m[i][right],end=" ")
    right=right-1
    
    if top<bottom:
        for i in range(right,left-1,-1):
            print(m[bottom][i],end=" ")
        bottom=bottom-1
        
    if left<right:
        for i in range(bottom,top-1,-1):
            print(m[i][left],end=" ")
        left=left+1
