s=input("enter any password: ")
up=0
lo=0
di=0
sc=0
if len(s)>7:
    for i in s:
        if i.isupper():
            up=up+1
        elif i.islower():
            lo=lo+1
        elif i.isdigit():
            di=di+1
        else:
            sc=sc+1
    if di>0 and sc>0 and up>0 and lo>0:
        print("IT IS STRONG")
    else:
        print("IT'S WEAK")
else:
    print("weak due to less charecter")
