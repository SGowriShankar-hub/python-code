class rect:
    def __init__ (self):
        self.l=int(input("enter the length: "))
        self.b=int(input("enter the breadth: "))
    def display(self):
        return self.l*self.b
n=int(input("enter the no.of rect: "))
l=[]
for i in range(n):
    r=rect()
    l.append(r)
for i in l:
    print("area:",i.display())
